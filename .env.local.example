# optimism.fun env vars
#
# Email capture + feedback both route through Resend (https://resend.com).
# Free tier: 3,000 emails/month + 1 audience list — enough for now.
#
# Admin panels:
#   Email signups → https://resend.com/audiences
#   Feedback      → whatever address you set RESEND_NOTIFY_EMAIL to (defaults
#                   to adamtpang@gmail.com). Each submission lands as a real
#                   email, so your inbox = your admin panel.
#
# Set these in Vercel: Settings → Environment Variables.

# Resend API key (server-side only; do NOT prefix NEXT_PUBLIC_)
RESEND_API_KEY=

# Audience ID from https://resend.com/audiences (one-per-product is fine)
RESEND_AUDIENCE_ID=

# Where feedback submissions get emailed. Optional — defaults to
# adamtpang@gmail.com if unset.
RESEND_NOTIFY_EMAIL=adamtpang@gmail.com

# Verified sender address. Must be verified in Resend Domains.
# If you haven't verified a domain yet, keep the Resend sandbox address.
RESEND_FROM_EMAIL=optimism.fun <onboarding@resend.dev>

# --- Problem sourcing (the daily /api/cron/problem-sourcing pipeline) ---
#
# Exa Agent (https://exa.ai/docs) — preferred sourcing engine. One async run
# does deep web research AND returns schema-validated, cited problem
# candidates. Server-side only; never prefix NEXT_PUBLIC_. Usage-based: priced
# per Agent Compute Unit + search call (effort defaults to "medium").
# Get a key at https://dashboard.exa.ai → API Keys.
EXA_API_KEY=

# Legacy news-signal path (optional; runs alongside Exa if both are set).
# GNews keyword search → Anthropic scores each signal into a candidate.
GNEWS_API_KEY=
ANTHROPIC_API_KEY=

# Neon Postgres — required to persist candidates for review at /admin/candidates.
# Without it the cron runs in stub mode (no writes).
DATABASE_URL=

# Shared secret for cron auth. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# --- Approval-gated social publishing ---
# X: OAuth 2.0 user token with tweet.write, users.read, and tweet.read scopes.
# Save each final uploaded PNG's media ID in its approval queue row.
X_USER_ACCESS_TOKEN=

# Instagram Graph API: a Business/Creator account connected to the Meta app.
# The final image must be reachable at a public HTTPS URL; save that URL in the
# approval queue before publishing. v23.0 is the current default but can be
# overridden when Meta deprecates it.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0

# --- The coordination board (/coordinate, the commitment layer) ---
#
# The board is the one live, user-generated dataset on the site. It uses the
# same DATABASE_URL as the other Neon-backed features, plus the 0005 migration:
#
#   psql "$DATABASE_URL" -f scripts/db/0005_commitments.sql
#
# Without it every page still renders. The board columns show their empty
# states and the submit endpoint replies 503 rather than pretending to save.
#
# Confirmation and notification email reuses RESEND_API_KEY above. With no key
# set, submissions are still stored and the confirmation link is written to the
# server log so it can be verified by hand.
#
# Used to build the confirmation link. Defaults to https://optimism.fun
NEXT_PUBLIC_BASE_URL=https://optimism.fun
