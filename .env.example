# PostHog product analytics. The rest of the local template is .env.local.example.
# Leave the key empty to leave PostHog uninitialized. Do not commit a real key.

# Public project token (Vercel: NEXT_PUBLIC_POSTHOG_KEY).
NEXT_PUBLIC_POSTHOG_KEY=

# Optional. /ingest, or an https host. Empty uses the same-origin /ingest proxy.
NEXT_PUBLIC_POSTHOG_HOST=
